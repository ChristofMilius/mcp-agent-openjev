# OpenJev Router environment
# Copy to .env. All values optional unless noted.

# OpenAI-compatible base URL of your decision model backend.
# Defaults to `http://localhost:1234/v1` (LM Studio local server).
JEV_BASE_URL=http://localhost:1234/v1

# Model id served by the backend. Pick a fast Tier-1/2 model.
JEV_MODEL=google/gemma-4-26b-a4b-qat

# Backend flavor: auto | chat | ollama | legacy.
#   chat    OpenAI /v1/chat/completions + logprobs (LM Studio, vLLM, SGLang, llama.cpp)
#   ollama  Ollama /api/chat scores path (stock openjevpro client)
#   legacy  Legacy /v1/completions logprobs path (stock openjevpro client)
#   auto    ollama when base_url contains `:11434`, otherwise chat
JEV_BACKEND=auto

# Score extraction method for the chat backend: auto | logprobs | scores.
#   logprobs  single-token letter logits + top_logprobs (fast, calibrated)
#   scores    full JSON likelihood scores (works on any chat endpoint)
JEV_METHOD=auto

# Inference-provider API key. Sent as `Authorization: Bearer` only when set;
# falls back to LM_STUDIO_API_KEY when unset. Leave empty for unauthenticated
# backends (default local LM Studio).
JEV_API_KEY=

# Temperature scaling for softmax calibration (fit on offline validation).
# Higher spreads probabilities; OpenJev recommends 1.25 - 1.35.
JEV_TEMPERATURE=1.3

# Abstention threshold. A float between 0 and 1, or the string `auto`
# (scales to 1.25 / N candidates). Confidence below this yields UNKNOWN.
JEV_ABSTAIN_THRESHOLD=0.45

# Inject `reasoning_effort: none` so reasoning models do not burn the
# single-token budget in thinking output. Set 0 to leave thinking enabled.
JEV_DISABLE_REASONING=1

# Seconds before a decision request to the backend times out.
JEV_TIMEOUT=60

# How many top_logprobs to request for candidate scoring.
JEV_TOP_LOGPROBS=20